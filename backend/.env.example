# PostgreSQL / PostGIS / pgRouting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=routing_db

# Alternative: full DATABASE_URL (overrides POSTGRES_* if you adapt config)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/routing_db

# Pool de connexions (v1.2)
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5

# Auth (future)
JWT_SECRET=changeme_super_secret

# Google Routes API (optional, for traffic-aware comparison)
GOOGLE_ROUTES_API_KEY=

# Geocoder
GEOCODER_PROVIDER=photon
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_USER_AGENT=obstacles-project/1.0 (contact: dev@example.com)
GEOCODER_MIN_INTERVAL_SEC=0.3
GEOCODER_CACHE_TTL_DAYS=30

# Routing (v1.2)
# Coût Dijkstra/A*: time (minutes, trajet le plus rapide) | distance (comportement d'origine)
COST_MODEL=time
# Algorithme: auto (Dijkstra court / A* long) | dijkstra | astar
ROUTING_ALGO=auto
ASTAR_LONG_ROUTE_KM=40
# Cache des segments de route
ROUTE_CACHE=true
ROUTE_CACHE_TTL_MIN=10
ROUTE_CACHE_RETENTION_HOURS=6

# Obstacles (v1.2)
# true: fermetures multi-edges / sens / pénalité (table event_edge_closure)
# false: comportement d'origine (events_road_closed.edge_id uniquement)
MULTI_EDGE_CLOSURES=true

# Logging
LOG_LEVEL=INFO
